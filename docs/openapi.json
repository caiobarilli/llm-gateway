{
  "components": {
    "schemas": {
      "EsquemaJson": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Name",
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "title": "Schema",
            "type": "object"
          },
          "strict": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Strict"
          }
        },
        "required": [
          "name",
          "schema"
        ],
        "title": "EsquemaJson",
        "type": "object"
      },
      "FormatoDeResposta": {
        "additionalProperties": false,
        "properties": {
          "json_schema": {
            "$ref": "#/components/schemas/EsquemaJson"
          },
          "type": {
            "const": "json_schema",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "json_schema"
        ],
        "title": "FormatoDeResposta",
        "type": "object"
      },
      "Mensagem": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 8000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Mensagem",
        "type": "object"
      },
      "Pedido": {
        "additionalProperties": false,
        "properties": {
          "max_tokens": {
            "anyOf": [
              {
                "maximum": 1024,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Tokens"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Mensagem"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "maxLength": 100,
            "title": "Model",
            "type": "string"
          },
          "response_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FormatoDeResposta"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "stream": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stream"
          },
          "temperature": {
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temperature"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "Pedido",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "llm-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "saude_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Saude Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Saude"
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "completar_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pedido"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Completar"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "modelos_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Modelos V1 Models Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Modelos"
      }
    }
  }
}
